# Export these variables in your shell; no dotenv auto-loading.
MOSSMAIL_SUMMARIZER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=45
MOSSMAIL_DB=.local/mossmail.sqlite3
MOSSMAIL_PROTECTED_SENDERS=maya@cedar.example,security@cedar.example
MOSSMAIL_DEFER_HOURS=24
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Hosted TabPFN is separate, opt-in, and NEVER used by the dashboard by default.
MOSSMAIL_ALLOW_HOSTED_FEATURES=false
# TABPFN_TOKEN=replace-with-your-own-token
